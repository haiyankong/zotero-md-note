{
  "manifest_version": 2,
  "name": "zotero-md-note",
  "version": "0.1.8",
  "description": "Create a Markdown note for the selected Zotero item using its PDF filename.",
  "author": "haiyankong",
  "homepage_url": "https://github.com/haiyankong/zotero-md-note",
  "applications": {
    "gecko": {
      "id": "zotero-md-note@example.com",
      "strict_min_version": "9.0"
    },
    "zotero": {
      "id": "zotero-md-note@example.com",
      "update_url": "https://raw.githubusercontent.com/haiyankong/zotero-md-note/main/updates.json",
      "strict_min_version": "8.0-beta.21",
      "strict_max_version": "9.99.99"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zotero-md-note@example.com",
      "strict_min_version": "9.0"
    }
  }
}
